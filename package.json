{
  "name": "web-engineering-ilv-1st-playground",
  "version": "1.0.0",
  "description": "This repository is designed as the foundation for coding playgrounds in the Web Engineering course. It offers a structured space for experimenting with and mastering various web development technologies and practices. The project is based on [this](https://developer.mozilla.org/en-US/docs/Learn/Accessibility/Accessibility_troubleshooting) repository from MDN.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint ./js --ext .ts,.js",
    "lint:fix": "eslint ./js --ext .ts,.js --fix",
    "format": "prettier --write \"./js/**/*.{ts,js}\"",
    "format:check": "prettier --check \"./js/**/*.{ts,js}\"",
    "preview": "vite preview",
    "serve": "vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:production": "npm run clean && npm run type-check && npm run lint && npm run build",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "wildlife",
    "website",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "vite": "^7.1.10",
    "@vitejs/plugin-legacy": "^7.2.1",
    "typescript": "^5.9.3",
    "@types/node": "^24.8.1",
    "eslint": "^9.38.0",
    "@eslint/js": "^9.38.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "globals": "^16.4.0"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,html,css}": [
      "prettier --write"
    ]
  }
}
